#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path("..", __dir__)
expected = File.read(File.join(root, ".ruby-version")).strip
abort "Use pinned CRuby #{expected}" unless RUBY_ENGINE == "ruby" && expected == RUBY_VERSION

ranges = []
(0..0x10ffff).each do |point|
  next if (0xd800..0xdfff).cover?(point) || point.chr(Encoding::UTF_8).match?(/[[:print:]]/)

  if ranges.last && ranges.last[1] + 1 == point
    ranges.last[1] = point
  else
    ranges << [point, point]
  end
end

lines = ["// Generated by bin/generate-inspection-table with CRuby #{RUBY_VERSION}; do not edit.",
         "pub(super) const RANGES: &[(u32, u32)] = &["]
lines.concat(ranges.map { |first, last| "    (0x#{first.to_s(16)}, 0x#{last.to_s(16)})," })
lines << "];"
File.write(File.join(root, "runtime/rubast_runtime/src/text_io/inspection/nonprintable.rs"), "#{lines.join("\n")}\n")
